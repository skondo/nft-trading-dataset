 "cells": [
  {"cell_type": "markdown", "metadata": {}, "source": ["# Factor model preparation\n", "\n", "This notebook builds the minimal set of tables required for the two-factor model: `weekly_collection_panel_filtered` and `weekly_returns_vw`.\n"]},
  {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["import bigframes.pandas as bpd\n", "\n", "PROJECT_ID = '<YOUR_GCP_PROJECT_ID>'\n", "BASE_DATASET_ID = '<YOUR_BASE_BIGQUERY_DATASET>'\n", "ANALYTICS_DATASET_ID = '<YOUR_ANALYTICS_BIGQUERY_DATASET>'\n", "\n", "def fqn(dataset_id: str, table_name: str) -> str:\n", "    return f'{PROJECT_ID}.{dataset_id}.{table_name}'\n", "\n", "def is_exist_table(table_id: str) -> bool:\n", "    try:\n", "        _ = bpd.read_gbq(f'SELECT 1 FROM `{table_id}` LIMIT 1')\n", "        return True\n", "    except Exception:\n", "        return False\n"]},
  {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["def build_weekly_collection_panel_filtered(force_create: bool = False) -> None:\n", "    table_id = fqn(ANALYTICS_DATASET_ID, 'weekly_collection_panel_filtered')\n", "    src_table = fqn(BASE_DATASET_ID, 'nft_trading_usd_filtered')\n", "\n", "    if is_exist_table(table_id) and not force_create:\n", "        print(f'table: {table_id} exists, skip.')\n", "        return\n", "\n", "    sql = f"""\n", "    CREATE OR REPLACE TABLE `{table_id}` AS\n", "    SELECT\n", "      collection,\n", "      week_start,\n", "      APPROX_QUANTILES(SAFE_CAST(price_usd AS FLOAT64), 100)[OFFSET(50)] AS median_price_usd,\n", "      SUM(SAFE_CAST(price_usd AS FLOAT64)) AS total_volume_usd,\n", "      COUNT(*) AS tx_count\n", "    FROM `{src_table}`\n", "    WHERE price_usd IS NOT NULL\n", "      AND SAFE_CAST(price_usd AS FLOAT64) > 0\n", "      AND collection IS NOT NULL\n", "      AND week_start IS NOT NULL\n", "    GROUP BY collection, week_start\n", "    ORDER BY collection, week_start\n", "    """\n", "    _ = bpd.read_gbq(sql)\n", "    print(f'Built: {table_id}')\n", "\n", "def build_weekly_returns_vw(force_create: bool = False) -> None:\n", "    table_id = fqn(ANALYTICS_DATASET_ID, 'weekly_returns_vw')\n", "    nft_table = fqn(ANALYTICS_DATASET_ID, 'weekly_collection_panel_filtered')\n", "    fx_base_table = fqn(BASE_DATASET_ID, 'usd_eth_base')\n", "\n", "    if is_exist_table(table_id) and not force_create:\n", "        print(f'table: {table_id} exists, skip.')\n", "        return\n", "\n", "    sql = f"""\n", "    CREATE OR REPLACE TABLE `{table_id}` AS\n", "    WITH nft_ret AS (\n", "      SELECT\n", "        collection,\n", "        week_start,\n", "        total_volume_usd,\n", "        CASE\n", "          WHEN LAG(week_start) OVER (PARTITION BY collection ORDER BY week_start) IS NOT NULL\n", "           AND DATE_DIFF(week_start, LAG(week_start) OVER (PARTITION BY collection ORDER BY week_start), DAY) = 7\n", "           AND median_price_usd > 0\n", "           AND LAG(median_price_usd) OVER (PARTITION BY collection ORDER BY week_start) > 0\n", "          THEN LOG(SAFE_DIVIDE(median_price_usd, LAG(median_price_usd) OVER (PARTITION BY collection ORDER BY week_start)))\n", "          ELSE NULL\n", "        END AS nft_return\n", "      FROM `{nft_table}`\n", "    ),\n", "    market_ret AS (\n", "      SELECT week_start, SAFE_DIVIDE(SUM(nft_return * total_volume_usd), SUM(total_volume_usd)) AS market_return\n", "      FROM nft_ret\n", "      WHERE nft_return IS NOT NULL AND total_volume_usd IS NOT NULL\n", "      GROUP BY week_start\n", "    ),\n", "    fx_weekly AS (\n", "      SELECT week_start, AVG(SAFE_CAST(usd_eth_rate AS FLOAT64)) AS avg_usd_eth_rate\n", "      FROM `{fx_base_table}`\n", "      WHERE usd_eth_rate IS NOT NULL\n", "      GROUP BY week_start\n", "    ),\n", "    fx_ret AS (\n", "      SELECT week_start, LOG(SAFE_DIVIDE(avg_usd_eth_rate, LAG(avg_usd_eth_rate) OVER (ORDER BY week_start))) AS fx_return\n", "      FROM fx_weekly\n", "    )\n", "    SELECT n.collection, n.week_start, n.nft_return, m.market_return, f.fx_return\n", "    FROM nft_ret AS n\n", "    LEFT JOIN market_ret AS m ON n.week_start = m.week_start\n", "    LEFT JOIN fx_ret AS f ON n.week_start = f.week_start\n", "    WHERE n.nft_return IS NOT NULL\n", "    ORDER BY n.collection, n.week_start\n", "    """\n", "    _ = bpd.read_gbq(sql)\n", "    print(f'Built: {table_id}')\n"]},
  {"cell_type": "code", "execution_count": null, "metadata": {}, "outputs": [], "source": ["build_weekly_collection_panel_filtered(force_create=True)\n", "build_weekly_returns_vw(force_create=True)\n"]}
